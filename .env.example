# Адрес сайта без слеша на конце
NEXT_PUBLIC_SITE_URL=https://slingoemma.kz

# Аналитика: пустое значение = счётчик не подключается
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Подтверждение прав (Search Console, Яндекс Вебмастер)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Фичефлаги (1 = включено), по умолчанию выключены
FEATURE_BONUS_POPUP=
FEATURE_CITY_PAGES=
FEATURE_KK=

# Провайдер покупки: kaspi (этап 1-3)
CHECKOUT_PROVIDER=kaspi

# Токен Kaspi Merchant API (не нужен для MVP)
KASPI_MERCHANT_TOKEN=
